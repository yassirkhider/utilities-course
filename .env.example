# Copy this file to .env for local development (netlify dev reads it automatically).
# In production, set these as Environment Variables in the Netlify dashboard
# (Site configuration -> Environment variables). Never commit real secrets.

# Bcrypt hash of the admin password (NOT the plaintext password).
# Generate one with:  node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session tokens (JWT). Use 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional, temporary diagnostic switch — leave unset/false normally.
# Set to "true" on your Netlify site (then redeploy) to have real server error messages
# shown in the browser when something 500s, instead of only in the Netlify function logs.
# Turn it back off once you've found the cause — see README "Troubleshooting" section.
DEBUG_ERRORS=false

# Optional fallback — leave both BLANK unless you hit "MissingBlobsEnvironmentError" on a
# real production deploy (not local dev). Netlify normally wires up Blobs credentials to
# your functions automatically; a small number of sites don't get that automatic wiring for
# platform reasons outside this app's control. Setting these two forces explicit credentials
# instead. See README "Troubleshooting" for exactly where to find each value.
BLOBS_SITE_ID=
BLOBS_TOKEN=
